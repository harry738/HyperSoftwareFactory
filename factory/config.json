{
  "concurrency": 1,
  "max_rounds": 3,
  "base_branch": "main",
  "merge_method": "merge",
  "labels": {
    "queue": "factory",
    "needs_info": "factory:needs-info",
    "needs_human": "factory:needs-human"
  },
  "routing": {
    "low": {
      "code": "haiku"
    },
    "medium": {
      "code": "sonnet"
    },
    "high": {
      "code": "sonnet"
    }
  },
  "surface_reviewers": {
    "ui": {
      "ux": "sonnet",
      "ui": "haiku"
    },
    "security": {
      "security": "opus"
    }
  },
  "protected_paths": [
    "factory/checks.sh",
    "factory/config.json",
    "factory/bin/*",
    "CLAUDE.md",
    "AGENTS.md",
    ".github/workflows/*"
  ],
  "ports": {
    "base": 5100,
    "step": 10
  },
  "dev_server": [
    "node",
    "node_modules/next/dist/bin/next",
    "dev",
    "-p",
    "{port}"
  ],
  "prices_usd_per_mtok": {
    "claude-fable-5-1": {
      "input": 10,
      "output": 50,
      "cache_write_5m": 12.5,
      "cache_write_1h": 20,
      "cache_read": 0.25
    },
    "claude-opus-5-5": {
      "input": 4,
      "output": 20,
      "cache_write_5m": 5,
      "cache_write_1h": 8,
      "cache_read": 0.2
    },
    "claude-sonnet-5-5": {
      "input": 2,
      "output": 10,
      "cache_write_5m": 2.5,
      "cache_write_1h": 4,
      "cache_read": 0.1
    },
    "claude-haiku-5-5": {
      "input": 0.1,
      "output": 0.5,
      "cache_write_5m": 0.125,
      "cache_write_1h": 0.2,
      "cache_read": 0.01
    },
    "claude-fable-5-2": {
      "input": 8,
      "output": 40,
      "cache_write_5m": 10,
      "cache_write_1h": 16,
      "cache_read": 0.2
    }
  },
  "merge_policy": {
    "allow_unattended": false,
    "unattended_risk": "low"
  },
  "risk_paths": {
    "high": [
      "factory/**",
      ".claude/**",
      ".github/workflows/**",
      "**/auth/**",
      "**/permissions/**",
      "**/migrations/**",
      "**/payments/**",
      "**/security/**",
      "**/ledger/**",
      "**/secrets/**",
      "**/package.json",
      "**/package-lock.json",
      "package.json",
      "package-lock.json",
      "pyproject.toml"
    ],
    "low": [
      "README.md",
      "docs/**",
      "**/*.md"
    ]
  }
}
