{
  "concurrency": 1,
  "max_rounds": 3,
  "base_branch": "main",
  "merge_method": "merge",
  "unattended_merge": false,
  "job_budget_usd": 15,
  "daily_budget_usd": 50,
  "stage_budget_usd": 5,
  "stage_max_turns": 300,
  "stage_timeout_minutes": 60,
  "stage_stall_minutes": 20,
  "retry_waits_seconds": [
    30,
    120,
    480
  ],
  "trusted_logins": [],
  "labels": {
    "queue": "factory",
    "needs_info": "factory:needs-info",
    "needs_human": "factory:needs-human",
    "ready": "ready-for-agent",
    "human_merge": "human-merge"
  },
  "routing": {
    "low": {
      "code": "haiku"
    },
    "medium": {
      "code": "sonnet"
    },
    "high": {
      "code": "sonnet"
    }
  },
  "surface_reviewers": {
    "ui": {
      "ux": "sonnet",
      "ui": "haiku"
    },
    "security": {
      "security": "opus"
    }
  },
  "protected_paths": [
    "factory/checks.sh",
    "factory/config.json",
    "factory/bin/*",
    "CLAUDE.md",
    "AGENTS.md",
    ".github/workflows/*",
    ".claude/*"
  ],
  "sensitive_paths": [
    "*package.json",
    "*package-lock.json",
    "*pnpm-lock.yaml",
    "*yarn.lock",
    "*.env*"
  ],
  "sensitive_reviewers": {
    "code": "sonnet",
    "security": "opus"
  },
  "risk_paths": {
    "low": [
      "*.md",
      "docs/*"
    ],
    "high": []
  },
  "ports": {
    "base": 5100,
    "step": 10
  },
  "dev_server": [
    "node",
    "node_modules/next/dist/bin/next",
    "dev",
    "-p",
    "{port}"
  ],
  "prices_usd_per_mtok": {
    "claude-fable-5-1": {
      "input": 10.0,
      "output": 50.0,
      "cache_write_5m": 12.5,
      "cache_write_1h": 20.0,
      "cache_read": 0.25
    },
    "claude-opus-5-5": {
      "input": 4.0,
      "output": 20.0,
      "cache_write_5m": 5.0,
      "cache_write_1h": 8.0,
      "cache_read": 0.2
    },
    "claude-sonnet-5-5": {
      "input": 2.0,
      "output": 10.0,
      "cache_write_5m": 2.5,
      "cache_write_1h": 4.0,
      "cache_read": 0.1
    },
    "claude-haiku-5-5": {
      "input": 0.1,
      "output": 0.5,
      "cache_write_5m": 0.125,
      "cache_write_1h": 0.2,
      "cache_read": 0.01
    },
    "claude-fable-5-2": {
      "input": 8.0,
      "output": 40.0,
      "cache_write_5m": 10.0,
      "cache_write_1h": 16.0,
      "cache_read": 0.2
    }
  }
}
