#!/usr/bin/env python
"""The deterministic gate: does the job's branch pass the repo's checks?

Usage:
  gate <job-id>            write round-N/checks.md; exit 0 on PASS, 1 on FAIL
  gate <job-id> --merge    same, as round-N/merge-checks.md (job merge runs it)
  gate --hook              builder SubagentStop hook: run the checks once, exit 2 on failure
  gate --checks            run the checks in the current folder, as the builder does

The gate runs the main checkout's factory/checks.sh inside the job's worktree,
so a branch can't change the checks it is judged by. It also fails when the
branch adds, modifies, deletes or renames a file matching config.json
`protected_paths` (fnmatch patterns, where `*` also matches `/`). A new file
counts: a new CI workflow or agent definition changes what runs as much as an
edited one.

The gate's own run (not the builder's) has the build caches off: a cached PASS
replays results without running the tests. It sets FACTORY_GATE=1, TURBO_FORCE
and NX_SKIP_NX_CACHE, plus config.json `gate_env` for any other tool's switch;
checks.sh can test FACTORY_GATE for a cache that has no environment switch.
"""

import fnmatch
import json
import os
import subprocess
import sys
import time
from pathlib import Path

import proc  # binley: Windows process helpers, factory/bin/proc.py

proc.setup()

LAYOUT = proc.layout(__file__)  # central home, or the factory inside the project's repo
REPO, JOBS, CHECKS = LAYOUT["repo"], LAYOUT["jobs"], LAYOUT["checks"]
CONFIG = json.loads(LAYOUT["config"].read_text())
TAIL = 80
# A cached PASS is not evidence (build plan E3.4): the gate's run bypasses the build caches.
NO_CACHE = {"FACTORY_GATE": "1", "TURBO_FORCE": "true", "NX_SKIP_NX_CACHE": "true", **CONFIG.get("gate_env", {})}


def die(msg):
    print(f"gate: {msg}", file=sys.stderr)
    sys.exit(2)


def git(worktree, *args):
    res = subprocess.run(["git", *args], cwd=worktree, capture_output=True, text=True)
    if res.returncode != 0:
        die(f"`git {' '.join(args)}` failed: {res.stderr.strip()}")
    return res.stdout


def protected_changes(worktree):
    """Files under protected_paths that the branch added, modified, deleted, or
    renamed or copied in or out of."""
    diff = git(worktree, "diff", "--name-status", f"origin/{CONFIG['base_branch']}...HEAD")
    hits = []
    for line in diff.splitlines():
        status, *paths = line.split("\t")
        for path in paths:  # renames and copies list the old path and the new one
            if any(fnmatch.fnmatch(path, pattern) for pattern in CONFIG["protected_paths"]):
                hits.append(f"{status[0]} {path}")
    return hits


bash = proc.bash  # binley: Git Bash on Windows, not WSL


def git_dir(worktree):
    return Path(git(worktree, "rev-parse", "--absolute-git-dir").strip())


def clean_head(worktree):
    """HEAD's commit when the tree has no uncommitted changes, else None."""
    if git(worktree, "status", "--porcelain").strip():
        return None
    return git(worktree, "rev-parse", "HEAD").strip()


def run_checks(worktree, capture=True, env=None):
    """Returns (exit code, log, seconds running, seconds waiting for the lock)."""
    # binley: one checks.sh at a time per worktree, so the builder's run and its
    # Stop hook's run never install node_modules at once. The lock waits.
    marker = git_dir(worktree) / "factory-checks-passed"
    asked = time.monotonic()
    with open(git_dir(worktree) / "factory-checks.lock", "w") as f:
        proc.lock(f)
        start = time.monotonic()
        head = clean_head(worktree)
        res = subprocess.run([bash(), CHECKS.as_posix()], cwd=worktree, capture_output=capture, text=True, env=env)
        # binley: remember a clean pass, so the Stop hook needn't run the same checks again
        if res.returncode == 0 and head and clean_head(worktree) == head:
            marker.write_text(head)
        else:
            marker.unlink(missing_ok=True)
    end = time.monotonic()
    return res.returncode, (res.stdout or "") + (res.stderr or ""), int(end - start), int(start - asked)


def passed_on_head(worktree):
    """True when the last checks run in this worktree passed on the current, clean HEAD."""
    marker = git_dir(worktree) / "factory-checks-passed"
    head = clean_head(worktree)
    return bool(head) and marker.exists() and marker.read_text().strip() == head


def gate(job_id, merge):
    job = json.loads((JOBS / job_id / "job.json").read_text())
    worktree = job["worktree"]
    if job["round"] < 1:
        die(f"{job_id} hasn't started a build round")
    round_dir = JOBS / job_id / f"round-{job['round']}"
    commit = git(worktree, "rev-parse", "HEAD").strip()
    protected = protected_changes(worktree)
    code, log, seconds, waited = run_checks(worktree, env={**os.environ, **NO_CACHE})  # always run by the gate itself
    verdict = "PASS" if code == 0 and not protected else "FAIL"
    name = "merge-checks" if merge else "checks"
    (round_dir / f"{name}.log").write_text(log)
    tail = "\n".join(log.rstrip().splitlines()[-TAIL:])
    summary = [
        f"checks.sh {'passed' if code == 0 else f'failed with exit {code}'} in {seconds}s"
        + (f", after waiting {waited}s for another checks run in this worktree" if waited > 5 else ""),
        f"Protected paths: {'changed: ' + ', '.join(protected) if protected else 'none changed'}",
        f"Commit {commit[:7]}" + (", synced with the latest main before merging" if merge else ""),
        "Build caches off: " + ", ".join(f"{k}={v}" for k, v in NO_CACHE.items()),
    ]
    (round_dir / f"{name}.md").write_text(
        f"GATE: {verdict}\nCOMMIT: {commit}\n\n"
        "## Summary\n" + "\n".join(f"- {s}" for s in summary) + "\n\n"
        "## Protected paths\n"
        + ("\n".join(f"- {p}" for p in protected) if protected else "None changed.")
        + f"\n\n## checks.sh\nExit {code} in {seconds}s. Last {TAIL} lines of {name}.log:\n\n```\n{tail}\n```\n"
    )
    print(f"GATE: {verdict} ({job_id} round {job['round']}, checks.sh exit {code} in {seconds}s"
          + (f", protected paths changed: {', '.join(protected)}" if protected else "") + ")")
    sys.exit(0 if verdict == "PASS" else 1)


def hook():
    event = json.load(sys.stdin)
    if event.get("stop_hook_active"):
        sys.exit(0)  # one nudge per stop; the gate decides
    with open(Path(event["agent_transcript_path"]).expanduser()) as f:
        content = json.loads(f.readline())["message"]["content"]
    prompt = content if isinstance(content, str) else " ".join(b.get("text", "") for b in content)
    job_id = prompt.split("Job: ", 1)[1].split(".", 1)[0]
    job = json.loads((JOBS / job_id / "job.json").read_text())
    if passed_on_head(job["worktree"]):
        sys.exit(0)  # binley: the builder's own run already passed on this commit
    code, log, _, _ = run_checks(job["worktree"])
    if code != 0:
        tail = "\n".join(log.rstrip().splitlines()[-40:])
        print(f"factory/checks.sh fails in your worktree (exit {code}). The gate will reject this "
              f"build. Fix it, or write STATUS: BLOCKED in build.md if you can't.\n\n{tail}",
              file=sys.stderr)
        sys.exit(2)


def main(argv):
    if argv == ["--hook"]:
        hook()
    elif argv == ["--checks"]:
        sys.exit(run_checks(Path.cwd(), capture=False)[0])
    elif len(argv) == 1 and not argv[0].startswith("-"):
        gate(argv[0], merge=False)
    elif len(argv) == 2 and argv[1] == "--merge":
        gate(argv[0], merge=True)
    else:
        die(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
